<% pageTitle = 'Welcome' %>
<%- include('partials/header') %>

<section style="max-width:600px; margin:0 auto; padding:32px 20px 8px; text-align:center;">
    <div style="display:flex; justify-content:center; gap:-10px; margin-bottom:20px;">
        <div style="width:64px; height:64px; border-radius:50%; background:var(--gradient); display:flex; align-items:center; justify-content:center; font-size:28px; margin-right:-14px; border:3px solid white;">🧑🏾‍💻</div>
        <div style="width:64px; height:64px; border-radius:50%; background:linear-gradient(135deg, var(--charcoal), var(--gray)); display:flex; align-items:center; justify-content:center; font-size:28px; border:3px solid white;">🤝</div>
    </div>
    <h1 style="font-size:30px; margin:0 0 12px;">Malawi's local talent, one tap away.</h1>
    <p style="color:var(--gray); font-size:16px; line-height:1.5; margin-bottom:24px;">
        AnayaPlus connects you with trusted local freelancers — designers, developers, photographers, tutors, artisans — for any job, big or small. Payments are held safely until the work is done.
    </p>
    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
        <a href="/signup" class="btn btn-primary" style="width:auto; padding:14px 28px;">Get Started</a>
        <a href="/login" class="btn" style="width:auto; padding:14px 28px; border:2px solid var(--orange); color:var(--orange);">Log In</a>
    </div>
</section>

<section style="max-width:600px; margin:40px auto; padding:0 20px;">
    <h2 style="text-align:center; font-size:22px; margin-bottom:24px;">How it works</h2>
    <div style="display:flex; flex-direction:column; gap:20px;">
        <div style="display:flex; gap:16px; align-items:flex-start;">
            <div style="width:48px; height:48px; border-radius:50%; background:var(--gradient); flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:22px;">📝</div>
            <div>
                <h3 style="margin:0 0 4px; font-size:17px;">Post or browse jobs</h3>
                <p style="margin:0; color:var(--gray); font-size:14px;">Clients post what they need. Freelancers browse and apply to jobs that match their skills.</p>
            </div>
        </div>
        <div style="display:flex; gap:16px; align-items:flex-start;">
            <div style="width:48px; height:48px; border-radius:50%; background:var(--gradient); flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:22px;">🔒</div>
            <div>
                <h3 style="margin:0 0 4px; font-size:17px;">Pay safely through escrow</h3>
                <p style="margin:0; color:var(--gray); font-size:14px;">Payment is held by AnayaPlus and only released once the work is confirmed done.</p>
            </div>
        </div>
        <div style="display:flex; gap:16px; align-items:flex-start;">
            <div style="width:48px; height:48px; border-radius:50%; background:var(--gradient); flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:22px;">✅</div>
            <div>
                <h3 style="margin:0 0 4px; font-size:17px;">Get it done, get paid</h3>
                <p style="margin:0; color:var(--gray); font-size:14px;">Job complete, payment released, freelancer paid. Simple and secure.</p>
            </div>
        </div>
    </div>
</section>

<div class="container">
    <div class="section-title">Categories</div>
    <div style="display:flex; flex-wrap:wrap; gap:10px;">
        <% categories.forEach(cat => { %>
            <a href="/jobs?category=<%= cat.id %>" style="background:var(--light-bg); padding:8px 14px; border-radius:20px; font-size:14px; color:var(--charcoal);"><%= cat.name %></a>
        <% }) %>
    </div>
</div>

<div class="container">
    <div class="section-title">Recent Jobs</div>
    <% if (recentJobs.length === 0) { %>
        <p style="color:var(--gray);">No open jobs yet — be the first to post one.</p>
    <% } %>
    <% recentJobs.forEach(job => { %>
        <div class="card" style="border:1px solid #eee; border-radius:10px; padding:16px; margin-bottom:14px;">
            <h3 style="margin:0 0 4px;"><a href="/jobs/<%= job.id %>"><%= job.title %></a></h3>
            <p style="color:var(--gray); font-size:14px; margin:0;"><%= job.category_name %> · MWK <%= job.budget_mwk.toLocaleString() %></p>
        </div>
    <% }) %>
</div>

<%- include('partials/footer') %>
