<% pageTitle = 'Welcome' %>
<%- include('partials/header') %>

<style>
    .fade-up {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .fade-up.show {
        opacity: 1;
        transform: translateY(0);
    }
    .avatar-pop {
        animation: popIn 0.6s ease backwards;
    }
    @keyframes popIn {
        from { opacity: 0; transform: scale(0.6); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

<!-- HERO -->
<section style="max-width:600px; margin:0 auto; padding:36px 20px 8px; text-align:center;">
    <div style="display:flex; justify-content:center; margin-bottom:22px;">
        <div class="avatar-pop" style="width:64px; height:64px; border-radius:50%; background:var(--gradient); display:flex; align-items:center; justify-content:center; font-size:28px; margin-right:-14px; border:3px solid white; animation-delay:0.05s;">🧑🏾‍💻</div>
        <div class="avatar-pop" style="width:64px; height:64px; border-radius:50%; background:linear-gradient(135deg, var(--charcoal), var(--gray)); display:flex; align-items:center; justify-content:center; font-size:28px; border:3px solid white; animation-delay:0.2s;">🤝</div>
        <div class="avatar-pop" style="width:64px; height:64px; border-radius:50%; background:var(--gradient); display:flex; align-items:center; justify-content:center; font-size:28px; margin-left:-14px; border:3px solid white; animation-delay:0.35s;">👩🏽‍🎨</div>
    </div>
    <h1 style="font-size:30px; margin:0 0 12px;">Malawi's local talent, one tap away.</h1>
    <p style="color:var(--gray); font-size:16px; line-height:1.5; margin-bottom:24px;">
        AnayaPlus connects you with trusted local freelancers — designers, developers, photographers, tutors, artisans — for any job, big or small. Payments are held safely until the work is done.
    </p>
    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
        <a href="/signup" class="btn btn-primary" style="width:auto; padding:14px 28px;">Get Started</a>
        <a href="/login" class="btn" style="width:auto; padding:14px 28px; border:2px solid var(--orange); color:var(--orange);">Log In</a>
    </div>
</section>

<!-- TRUST STRIP -->
<section class="fade-up" style="max-width:600px; margin:32px auto 0; padding:0 20px;">
    <div style="background:var(--light-bg); border-radius:16px; padding:18px; display:flex; align-items:center; justify-content:space-around; text-align:center;">
        <div>
            <div style="font-size:20px; font-weight:700; color:var(--orange);">100%</div>
            <div style="font-size:12px; color:var(--gray);">Escrow protected</div>
        </div>
        <div>
            <div style="font-size:20px; font-weight:700; color:var(--orange);">Local</div>
            <div style="font-size:12px; color:var(--gray);">Malawian talent</div>
        </div>
        <div>
            <div style="font-size:20px; font-weight:700; color:var(--orange);">Verified</div>
            <div style="font-size:12px; color:var(--gray);">ID-checked freelancers</div>
        </div>
    </div>
</section>

<!-- HOW IT WORKS -->
<section class="fade-up" style="max-width:600px; margin:40px auto; padding:0 20px;">
    <h2 style="text-align:center; font-size:22px; margin-bottom:24px;">How it works</h2>
    <div style="display:flex; flex-direction:column; gap:20px;">
        <div style="display:flex; gap:16px; align-items:flex-start;">
            <div style="width:48px; height:48px; border-radius:50%; background:var(--gradient); flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:22px;">📝</div>
            <div>
                <h3 style="margin:0 0 4px; font-size:17px;">Post or browse jobs</h3>
                <p style="margin:0; color:var(--gray); font-size:14px;">Clients post what they need. Freelancers browse and apply to jobs that match their skills.</p>
            </div>
        </div>
        <div style="display:flex; gap:16px; align-items:flex-start;">
            <div style="width:48px; height:48px; border-radius:50%; background:var(--gradient); flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:22px;">🔒</div>
            <div>
                <h3 style="margin:0 0 4px; font-size:17px;">Pay safely through escrow</h3>
                <p style="margin:0; color:var(--gray); font-size:14px;">Payment is held by AnayaPlus and only released once the work is confirmed done.</p>
            </div>
        </div>
        <div style="display:flex; gap:16px; align-items:flex-start;">
            <div style="width:48px; height:48px; border-radius:50%; background:var(--gradient); flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:22px;">✅</div>
            <div>
                <h3 style="margin:0 0 4px; font-size:17px;">Get it done, get paid</h3>
                <p style="margin:0; color:var(--gray); font-size:14px;">Job complete, payment released, freelancer paid. Simple and secure.</p>
            </div>
        </div>
    </div>
</section>

<!-- WHY PEOPLE LIKE IT -->
<section class="fade-up" style="max-width:600px; margin:40px auto; padding:0 20px;">
    <h2 style="text-align:center; font-size:22px; margin-bottom:24px;">Built for Malawi</h2>
    <div style="display:flex; flex-direction:column; gap:14px;">
        <div style="background:var(--light-bg); border-radius:14px; padding:16px; display:flex; gap:14px; align-items:center;">
            <div style="width:44px; height:44px; border-radius:50%; background:var(--gradient); flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:20px;">👨🏿‍🔧</div>
            <p style="margin:0; font-size:14px; color:var(--charcoal);">"I found steady work close to home and got paid on time, every time." — a local freelancer</p>
        </div>
        <div style="background:var(--light-bg); border-radius:14px; padding:16px; display:flex; gap:14px; align-items:center;">
            <div style="width:44px; height:44px; border-radius:50%; background:linear-gradient(135deg, var(--charcoal), var(--gray)); flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:20px;">👩🏾‍💼</div>
            <p style="margin:0; font-size:14px; color:var(--charcoal);">"Posting a job took two minutes, and I hired someone I trusted within a day." — a local client</p>
        </div>
    </div>
</section>

<!-- CATEGORIES -->
<div class="fade-up container" style="max-width:600px; margin:0 auto 40px; padding:0 20px;">
    <div class="section-title">Categories</div>
    <div style="display:flex; flex-wrap:wrap; gap:10px;">
        <% categories.forEach(cat => { %>
            <a href="/jobs?category=<%= cat.id %>" style="background:var(--light-bg); padding:8px 14px; border-radius:20px; font-size:14px; color:var(--charcoal);"><%= cat.name %></a>
        <% }) %>
    </div>
</div>

<script>
    const fadeEls = document.querySelectorAll('.fade-up');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('show');
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.15 });
    fadeEls.forEach(el => observer.observe(el));
</script>

<%- include('partials/footer') %>
