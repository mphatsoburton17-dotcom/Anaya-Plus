<% pageTitle = 'My Jobs' %>
<%- include('partials/header') %>

<div class="container">
    <div class="section-title">My Posted Jobs</div>
    <a href="/jobs/new" class="btn btn-primary" style="width:auto; display:inline-block; margin-bottom:20px;">+ Post a New Job</a>

    <% if (jobs.length === 0) { %>
        <p>You haven't posted any jobs yet.</p>
    <% } %>
    <% jobs.forEach(job => { %>
        <a href="/jobs/<%= job.id %>" class="card" style="display:block;">
            <h3 style="margin:0 0 4px;"><%= job.title %></h3>
            <span class="badge"><%= job.status %></span>
            <p style="color:var(--gray);">MWK <%= job.budget_mwk.toLocaleString() %> · <%= job.city %></p>
        </a>
    <% }) %>
</div>

<%- include('partials/footer') %>
