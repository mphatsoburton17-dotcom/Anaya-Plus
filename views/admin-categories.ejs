<%- include('partials/header') %>

<style>
  .cat-wrap { max-width: 700px; margin: 30px auto; padding: 0 16px; }
  .cat-form { display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; }
  .cat-form input[type="text"] {
    flex: 1; min-width: 150px; padding: 10px 12px; border: 1px solid #ddd;
    border-radius: 8px; font-size: 15px;
  }
  .cat-form label { display: flex; align-items: center; gap: 6px; font-size: 14px; }
  .cat-form button {
    background: linear-gradient(90deg, #ff8c00, #ffb400);
    color: white; border: none; padding: 10px 18px; border-radius: 8px;
    font-weight: bold; cursor: pointer;
  }
  .cat-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 14px; border: 1px solid #eee; border-radius: 8px; margin-bottom: 8px;
  }
  .cat-name { font-weight: 600; }
  .cat-remote {
    font-size: 12px; background: #fff3e0; color: #e67e00;
    padding: 2px 8px; border-radius: 12px; margin-left: 8px;
  }
  .cat-delete {
    background: none; border: none; color: #c0392b; cursor: pointer; font-size: 14px;
  }
</style>

<div class="cat-wrap">
  <h1>Manage Job Categories</h1>

  <form class="cat-form" action="/admin/categories" method="POST">
    <input type="text" name="name" placeholder="New category name" required />
    <label>
      <input type="checkbox" name="is_remote" value="1" />
      Remote-friendly
    </label>
    <button type="submit">Add Category</button>
  </form>

  <% if (categories.length === 0) { %>
    <p>No categories yet.</p>
  <% } else { %>
    <% categories.forEach(cat => { %>
      <div class="cat-item">
        <span class="cat-name">
          <%= cat.name %>
          <% if (cat.is_remote) { %>
            <span class="cat-remote">Remote</span>
          <% } %>
        </span>
        <form action="/admin/categories/<%= cat.id %>/delete" method="POST" onsubmit="return confirm('Delete this category?');">
          <button class="cat-delete" type="submit">Delete</button>
        </form>
      </div>
    <% }) %>
  <% } %>
</div>

<%- include('partials/footer') %>
